# 실제 키를 이 파일이나 Git에 넣지 마세요.
BUILDING_HUB_API_KEY = "공공데이터포털 일반 인증키"

# 선택: Streamlit Cloud에서 건축HUB 직접 연결이 계속 실패할 때만 사용합니다.
# 운영 중인 무료 Supabase 서울 중계 URL은 src/relay_config.py에 기본값으로
# 지정되어 있으므로 이 항목은 생략합니다. 다른 중계를 쓸 때만 덮어쓰세요.
# BUILDING_HUB_RELAY_URL = "https://project.supabase.co/functions/v1/building-hub-relay"

# 선택: 기존 배포와의 하위 호환용 명시적 HMAC secret. 새 무료 배포에는 불필요합니다.
# BUILDING_HUB_RELAY_HMAC_SECRET = "long-random-secret"

# 선택: 건축인허가정보 서비스가 별도 인증키를 쓰는 경우에만 지정하세요.
# 생략하면 BUILDING_HUB_API_KEY를 재사용합니다.
# ARCH_PMS_HUB_API_KEY = "공공데이터포털 건축인허가정보 인증키"

# 선택: 위반건축물 참고정보(VWorld GIS건물통합정보)
# VWORLD_API_KEY = "VWorld API 키"
# VWORLD_DOMAIN = "won-top-finder-work.streamlit.app"
